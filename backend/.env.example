# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# CORS Configuration (Allowed frontend origin)
CORS_ORIGINS=http://localhost:3000

# Model Paths
MODEL_PATH=../ML/models/final_model.joblib
MODEL_INFO_PATH=../ML/models/final_model_info.json

# Security / App Secret Key
SECRET_KEY=change-this-in-production-hotel-booking-secret
