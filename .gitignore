# ==========================================
# Root .gitignore
# Hotel Booking Cancellation Prediction
# ==========================================

# --- Environment Files (Keep secrets safe; commit *.env.example instead) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
!**/.env.example

# --- Python & Virtual Environments ---
**/venv/
**/.venv/
**/env/
**/ENV/
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node.js & Frontend ---
**/node_modules/
**/.next/
**/out/
**/build/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# --- Jupyter Notebooks & Data Caches ---
**/.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Large Machine Learning Artifacts ---
# NOTE: GitHub rejects individual files over 100 MB.
# baseline_random_forest.joblib is ~700MB. Use Git LFS if you need to track it.
ML/models/baseline_random_forest.joblib

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
